<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RouteFlow.App"
             xmlns:local="using:RouteFlow"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <Color x:Key="SystemAccentColor">#16735C</Color>
        <Color x:Key="SystemAccentColorLight1">#258267</Color>
        <Color x:Key="SystemAccentColorLight2">#5FAE94</Color>
        <Color x:Key="SystemAccentColorLight3">#B9DCCE</Color>
        <Color x:Key="SystemAccentColorDark1">#115F4C</Color>
        <Color x:Key="SystemAccentColorDark2">#0D4C3D</Color>
        <Color x:Key="SystemAccentColorDark3">#08382D</Color>
        <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="15,1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#E8EDF1" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#D9E0E6" />
        </Style>
        <Style Selector="Button.headerAction">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#16735C" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#115F4C" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#0D4C3D" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#B84942" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#9D3B36" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DDE2E7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#263746" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#52606D" />
        </Style>
        <Style Selector="Border.statusBadge">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#F2F4F6" />
            <Setter Property="BorderBrush" Value="#D8DEE4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.statusBadge.running">
            <Setter Property="Background" Value="#E8F4EF" />
            <Setter Property="BorderBrush" Value="#B9DCCE" />
        </Style>
        <Style Selector="TabItem.settingsTab">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="#E7EBEF" />
            <Setter Property="Foreground" Value="#52606D" />
            <Setter Property="BorderBrush" Value="#D6DDE3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem.settingsTab:pointerover">
            <Setter Property="Background" Value="#DDE4E9" />
            <Setter Property="Foreground" Value="#263746" />
        </Style>
        <Style Selector="TabItem.settingsTab:selected">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#12644F" />
            <Setter Property="BorderBrush" Value="#9FCDBD" />
        </Style>
        <Style Selector="TextBox.routeEditor">
            <Setter Property="Height" Value="260" />
            <Setter Property="MinHeight" Value="260" />
            <Setter Property="MaxHeight" Value="260" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="#C9D1D9" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox.routeEditor:focus">
            <Setter Property="BorderBrush" Value="#258267" />
        </Style>
        <Style Selector="Border.modeSwitch">
            <Setter Property="Background" Value="#E7EBEF" />
            <Setter Property="BorderBrush" Value="#D4DCE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style Selector="Button.modeOption">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#52606D" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.modeOption:pointerover">
            <Setter Property="Background" Value="#DCE3E8" />
        </Style>
        <Style Selector="Button.modeOption.selected">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#12644F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>
