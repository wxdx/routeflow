<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RouteFlow.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="RouteFlow.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/routeflow.ico"
        Title="RouteFlow"
        Width="1100" Height="760" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto" Background="#F3F5F7">
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DDE2E7" BorderThickness="0,0,0,1" Padding="22,15">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center" Spacing="5">
          <TextBlock Text="RouteFlow" FontSize="21" FontWeight="SemiBold" Foreground="#1D2733" />
          <StackPanel Orientation="Horizontal" Spacing="9">
            <TextBlock Text="{Binding PlatformText}" VerticalAlignment="Center" Foreground="#607080" />
            <Border Classes.statusBadge="True" Classes.running="{Binding IsRunning}">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#258267" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ProcessStateText}" FontWeight="SemiBold" Foreground="#31584D"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Classes="modeSwitch">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Content="本机分流" Command="{Binding SelectClientModeCommand}"
                        IsEnabled="{Binding CanChangeMode}" Classes="modeOption" Classes.selected="{Binding IsClientMode}" />
                <Button Content="内网中转" Command="{Binding SelectRelayModeCommand}"
                        IsEnabled="{Binding CanChangeMode}" Classes="modeOption" Classes.selected="{Binding IsRelayMode}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding StartStopText}" Command="{Binding ToggleProcessCommand}"
                IsEnabled="{Binding IsReady}" Classes="primary headerAction" Classes.danger="{Binding IsRunning}" />
        <Button Grid.Column="2" Content="重启" Command="{Binding RestartCommand}" IsEnabled="{Binding IsReady}" Classes="headerAction" />
        <Button Grid.Column="3" Content="重新加载" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsReady}" Classes="headerAction" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="18,14,18,10" IsVisible="{Binding IsClientMode}">
      <TabItem Header="常用配置" Classes="settingsTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14,4,18" Spacing="14">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Text="上游代理" Classes="sectionTitle" />
                  <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                    <TextBlock Grid.Row="0" Text="服务器地址" Classes="label" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProxyServer}" />
                    <TextBlock Grid.Row="1" Text="服务器端口" Classes="label" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ProxyPort}" />
                    <TextBlock Grid.Row="2" Text="连接测试" Classes="label" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                      <Button Content="测试上游" Command="{Binding TestProxyCommand}" IsEnabled="{Binding IsReady}" />
                      <TextBlock Text="{Binding ProxyTestText}" VerticalAlignment="Center" Foreground="#52606D" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Text="DNS over TLS" Classes="sectionTitle" />
                  <Grid ColumnDefinitions="145,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                    <TextBlock Grid.Row="0" Text="DNS 地址" Classes="label" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DnsServer}" />
                    <TextBlock Grid.Row="1" Text="端口（默认 853）" Classes="label" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DnsPort}" />
                    <TextBlock Grid.Row="2" Text="TLS Server Name" Classes="label" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DnsTlsName}" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Text="分流目标" Classes="sectionTitle" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,260" ColumnSpacing="14" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="IP / CIDR（每行一个）" Classes="label" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="域名（每行一个）" Classes="label" />
                  <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding RouteAddresses}"
                           AcceptsReturn="True" TextWrapping="NoWrap"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           Classes="routeEditor" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RouteDomains}"
                           AcceptsReturn="True" TextWrapping="NoWrap"
                           ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                           Classes="routeEditor" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="高级配置" Classes="settingsTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,14,4,18" Spacing="14">
            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Text="上游认证" Classes="sectionTitle" />
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="9" MaxWidth="620" HorizontalAlignment="Left">
                  <TextBlock Grid.Row="0" Text="用户名" Classes="label" />
                  <TextBox Grid.Row="0" Grid.Column="1" Width="420" Text="{Binding ProxyUsername}" />
                  <TextBlock Grid.Row="1" Text="密码" Classes="label" />
                  <TextBox Grid.Row="1" Grid.Column="1" Width="420" Text="{Binding ProxyPassword}" PasswordChar="●" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="10">
                <TextBlock Text="TUN" Classes="sectionTitle" />
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                  <TextBlock Grid.Row="0" Text="网卡名称" Classes="label" />
                  <TextBox Grid.Row="0" Grid.Column="1" Width="520" HorizontalAlignment="Left" Text="{Binding TunInterface}" />
                  <TextBlock Grid.Row="1" Text="TUN 地址" Classes="label" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TunAddresses}" AcceptsReturn="True" MinHeight="110" FontFamily="Consolas" />
                  <TextBlock Grid.Row="2" Text="路由选项" Classes="label" />
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="22">
                    <CheckBox Content="auto_route" IsChecked="{Binding AutoRoute}" />
                    <CheckBox Content="strict_route" IsChecked="{Binding StrictRoute}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <ScrollViewer Grid.Row="1" Margin="18,14,18,10" IsVisible="{Binding IsRelayMode}" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="4,4,4,18" Spacing="14">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Text="监听与连接" Classes="sectionTitle" />
              <Grid ColumnDefinitions="145,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="监听地址" Classes="label" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RelayListenAddress}" />
                <TextBlock Grid.Row="1" Text="监听端口" Classes="label" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RelayListenPort}" />
                <TextBlock Grid.Row="2" Text="客户端连接地址" Classes="label" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RelayClientAddress}" />
                <TextBlock Grid.Row="3" Text="连接测试" Classes="label" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Button Content="测试中转" Command="{Binding TestRelayCommand}" IsEnabled="{Binding IsReady}" />
                  <TextBlock Text="{Binding RelayTestText}" VerticalAlignment="Center" Foreground="#52606D" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Text="访问认证" Classes="sectionTitle" />
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                <TextBlock Grid.Row="0" Text="用户名" Classes="label" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RelayUsername}" />
                <TextBlock Grid.Row="1" Text="密码" Classes="label" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RelayPassword}" PasswordChar="●" />
              </Grid>
              <Border Background="#FFF8E6" BorderBrush="#E8D39A" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,8,0,0">
                <TextBlock Text="监听公网或局域网地址时，请配置防火墙来源范围；账号和密码将保存在本地配置中。"
                           TextWrapping="Wrap" Foreground="#725A22" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="panel">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border Background="#E8F4EF" BorderBrush="#B9DCCE" BorderThickness="1" CornerRadius="4" Padding="10,6">
              <TextBlock Text="HTTP / SOCKS" FontWeight="SemiBold" Foreground="#12644F" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="客户端连接信息" FontWeight="SemiBold" Foreground="#263746" />
              <TextBlock Text="{Binding RelayConnectionText}" FontFamily="Consolas" Foreground="#52606D" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDE2E7" BorderThickness="0,1,0,0" Padding="18,10">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <ProgressBar Width="54" Height="4" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#52606D" />
      </Grid>
    </Border>
  </Grid>
</Window>
